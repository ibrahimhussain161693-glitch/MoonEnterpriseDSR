<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MOON ENTERPRISE"
        android:textColor="#1A237E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DSR Dashboard"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Summary Card (Total Bill & Total Due) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Bill"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalBillSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tk. 0.0"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDDDDD" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Due"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalDueSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tk. 0.0"
                android:textColor="#C62828"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Buttons -->
    <Button
        android:id="@+id/btnNewBill"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="New Bill (মেমো তৈরি)"
        android:backgroundTint="#1A237E"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnShopList"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Shop List (দোকানের তালিকা)"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>