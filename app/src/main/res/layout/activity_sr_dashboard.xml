<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOON ENTERPRISE"
                android:textColor="#1A237E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSrInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SR: Rahim Ahmed"
                android:textColor="#555555"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#C62828"
            android:text="Logout"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Factory Stock Visibility"
        android:textColor="#1A237E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Stock Summary List -->
    <TextView
        android:id="@+id/tvStockList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="12dp"
        android:text="Loading company live stock..."
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- Navigation Buttons -->
    <Button
        android:id="@+id/btnRegisterShop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#2E7D32"
        android:text="📍 Notun Shop Register &amp; Tag Location"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1A237E"
        android:text="🛒 Place Order &amp; Route to DSR"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

</LinearLayout>
